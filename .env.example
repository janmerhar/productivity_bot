# Discord
DISCORD_TOKEN=your-discord-bot-token
DEV_MODE=false
DEV_GUILD_ID=
# DEV_MODE command scoping:
# - DEV_GUILD_ONLY_COMMANDS: top-level commands synced only to DEV_GUILD_ID
# - DEV_DM_ONLY_COMMANDS: top-level commands synced globally but visible only in bot DMs
# Command names are comma-separated top-level names, for example:
# DEV_GUILD_ONLY_COMMANDS=assistant
# DEV_DM_ONLY_COMMANDS=toggl,reminder,Create Reminder
DEV_GUILD_ONLY_COMMANDS=
DEV_DM_ONLY_COMMANDS=
SYNC_COMMANDS_ON_START=true

# Toggl
TOGGL_TOKEN=
TOGGL_SAVED_DISABLED=true

# TickTick (set TICK_DISABLED=true to skip these credentials)
TICK_DISABLED=true
TICK_ID=
TICK_SECRET=
TICK_URI=
TICK_EMAIL=
TICK_PASSWORD=

# Aliases (set ALIAS_DISABLED=true to skip loading AliasCog)
ALIAS_DISABLED=true

# Markets (set *_DISABLED=true to skip loading stock/crypto slash commands)
STOCK_DISABLED=true
CRYPTO_DISABLED=true

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=productivity_bot

# Logging
APP_LOG_LEVEL=INFO
LIB_LOG_LEVEL=WARNING
CONSOLE_LOG_LEVEL=INFO
APP_LOG_FILE=discord.log
DEPENDENCY_LOG_FILE=discord.deps.log
LOG_MAX_BYTES=33554432
LOG_BACKUP_COUNT=5

# Optional integrations
OPENAI_API_KEY=

# Automation
ALERT_EXPIRY_CLEANUP_MINUTES=15

# Pomodoro voice
POMODORO_AUDIO_PATH=
POMODORO_BREAK_AUDIO_PATH=
POMODORO_AUDIO_VOLUME=
POMODORO_VOICE_ASSETS=
